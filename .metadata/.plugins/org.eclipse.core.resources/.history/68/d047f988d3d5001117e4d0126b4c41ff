#include "circular_buffer.h"

struct CircularBuffer {
	uint8_t* buffer;
	size_t capacity;
	size_t start;
	size_t current;
	bool isFull;
};

size_t calculatePrevIndex(CircularBuffer* buffer, size_t index) {
	return index == 0 ? buffer->capacity - 1 : index - 1;
}

size_t calculateNextIndex(CircularBuffer* buffer, size_t index) {
	return index == buffer->capacity - 1 ? 0 : index + 1;
}

CircularBuffer* CircularBuffer_Create(size_t capacity) {
	CircularBuffer* buffer = malloc(sizeof *buffer);
	buffer->capacity = capacity;
	buffer->start = 0;
	buffer->current = 0;
	buffer->isFull = false;
	buffer->buffer = malloc(capacity * sizeof(uint8_t));
	return buffer;
}

size_t CircularBuffer_GetSize(CircularBuffer* buffer) {
	if (buffer->current <= buffer->start) {
		return buffer->current + (buffer->capacity - buffer->start);
	}

	return buffer->current - buffer->start - 1;
}

void CircularBuffer_Push(CircularBuffer* buffer, uint8_t byte) {
	buffer->buffer[buffer->current] = byte;

	buffer->current = calculateNextIndex(buffer, buffer->current);
	buffer->start =
		buffer->current == calculateNextIndex(buffer, buffer->start) ?
			calculateNextIndex(buffer, buffer->start) :
			buffer->start;
	buffer->isFull = buffer->current == buffer->start;
}

uint8_t CircularBuffer_Pop(CircularBuffer* buffer) {
	uint8_t byte = buffer->buffer[buffer->start];

	buffer->current = buffer->current
	buffer->start = buffer->start == buffer->capacity - 1 ? 0 : buffer->start + 1;

	return buffer->buffer[buffer->current];
}
