#include "circular_buffer.h"

struct CircularBuffer {
	uint8_t* buffer;
	size_t capacity;
	size_t start;
	size_t current;
};

CircularBuffer* CircularBuffer_Create(size_t capacity) {
	CircularBuffer* buffer = malloc(sizeof *buffer);
	buffer->capacity = capacity;
	buffer->start = 0;
	buffer->current = 0;
	buffer->buffer = malloc(capacity * sizeof(uint8_t));
	return buffer;
}

size_t CircularBuffer_GetSize(CircularBuffer* buffer) {
	if (buffer->current <= buffer->start) {
		return buffer->current + (buffer->capacity - buffer->start);
	}

	return buffer->current - buffer->start - 1;
}

void CircularBuffer_Push(CircularBuffer* buffer, uint8_t byte) {
	buffer->buffer[buffer->current] = byte;

	buffer->current = buffer->current == buffer->capacity - 1 ? 0 : buffer->current + 1;
	buffer->start += buffer->current == buffer->start ? 1 : 0;
}

uint8_t CircularBuffer_Pop(CircularBuffer* buffer) {
	if (buffer->current == buffer->start) {
		return 0;
	}

	buffer->current = buffer->current == 0 ? buffer->capacity - 1 : buffer->current - 1;

	return buffer->buffer[buffer->current];
}
