// Отправка одной управляющей команды
void SSD1315_WriteCommand(uint8_t cmd) {
    HAL_I2C_Mem_Write(&hi2c1, SSD1315_I2C_ADDR, 0x00, I2C_MEMADD_SIZE_8BIT, &cmd, 1, HAL_MAX_DELAY);
}

// Отправка всего буфера кадра на дисплей
void SSD1315_UpdateScreen(void) {
    // Возвращаем указатель адреса дисплея в начало (столбец 0, страница 0)
    SSD1315_WriteCommand(0x21); // Установка диапазона колонок
    SSD1315_WriteCommand(0);    // Старт
    SSD1315_WriteCommand(127);  // Конец

    SSD1315_WriteCommand(0x22); // Установка диапазона страниц (строк)
    SSD1315_WriteCommand(0);    // Старт
    SSD1315_WriteCommand(7);    // Конец (7 * 8 = 56, то есть до 63 строки)

    // Отправляем массив данных. Префикс 0x40 указывает, что это поток байт видеопамяти
    HAL_I2C_Mem_Write(&hi2c1, SSD1315_I2C_ADDR, 0x40, I2C_MEMADD_SIZE_8BIT, screen_buffer, 1024, HAL_MAX_DELAY);
}

void SSD1315_Init(void) {
    HAL_Delay(100); // Ждем стабилизации питания дисплея

    SSD1315_WriteCommand(0xAE); // Выключить дисплей (Sleep mode)

    SSD1315_WriteCommand(0x20); // Настройка адресации памяти
    SSD1315_WriteCommand(0x00); // 0x00 — Горизонтальная адресация (автоинкремент)

    SSD1315_WriteCommand(0xB0); // Установка стартового адреса страницы (0)

    SSD1315_WriteCommand(0xC8); // Переворот выходов COM (сканирование снизу вверх)
    SSD1315_WriteCommand(0x00); // Установка низшего адреса колонки
    SSD1315_WriteCommand(0x10); // Установка высшего адреса колонки
    SSD1315_WriteCommand(0x40); // Установка стартовой строки (0)

    SSD1315_WriteCommand(0x81); // Контрастность
    SSD1315_WriteCommand(0xCF); // Значение яркости от 0x00 до 0xFF

    SSD1315_WriteCommand(0xA1); // Переворот сегментов (разворот экрана по горизонтали)
    SSD1315_WriteCommand(0xA6); // Обычный режим (0xA7 — инверсный)

    SSD1315_WriteCommand(0xA8); // Мультиплексор (высота экрана)
    SSD1315_WriteCommand(0x3F); // 63 (для разрешения 128x64)

    SSD1315_WriteCommand(0xA4); // Вывод данных из RAM (0xA5 — включить все пиксели)
    SSD1315_WriteCommand(0xD3); // Смещение дисплея
    SSD1315_WriteCommand(0x00); // Без смещения

    SSD1315_WriteCommand(0xD5); // Частота генератора дисплея
    SSD1315_WriteCommand(0x80); // Рекомендуемое значение

    SSD1315_WriteCommand(0xD9); // Период предзаряда фаз
    SSD1315_WriteCommand(0xF1); // Рекомендуемое значение для SSD1315/SSD1306

    SSD1315_WriteCommand(0xDA); // Конфигурация пинов COM
    SSD1315_WriteCommand(0x12); // Альтернативная конфигурация (для 128x64)

    SSD1315_WriteCommand(0xDB); // Уровень VCOMH
    SSD1315_WriteCommand(0x40);

    SSD1315_WriteCommand(0x8D); // Управление встроенным насосом накачки (Charge Pump)
    SSD1315_WriteCommand(0x14); // 0x14 — Включить (без этого экран будет черным)

    SSD1315_WriteCommand(0xAF); // Включить дисплей (Display ON)
}

void SSD1315_DrawPixel(uint16_t x, uint16_t y, uint8_t color) {
    if (x >= 128 || y >= 64) {
    	return;
    }

    if (color) {
        screen_buffer[x + (y / 8) * 128] |= (1 << (y % 8));  // Зажечь пиксель
    } else {
        screen_buffer[x + (y / 8) * 128] &= ~(1 << (y % 8)); // Погасить пиксель
    }
}

void drawCross() {
	for (int i = 0; i < 1024; i++) {
		  screen_buffer[i] = 0x00;
	}

	for (uint16_t i = 0; i < 64; i++) {
	  SSD1315_DrawPixel(i * 2, i, 1);        // Линия из левого верхнего в правый нижний
	  SSD1315_DrawPixel(127 - (i * 2), i, 1); // Линия из правого верхнего в левый нижний
	}

	SSD1315_UpdateScreen();
}

// Главная функция отрисовки сцены
void drawScene() {
    const char* text = "Hello, world!";
    int textLength = 13; // Количество символов в строке

    // Размеры одного символа в пикселях
    int charWidth = 8;
    int charHeight = 16;

    // Коэффициент масштабирования (увеличим текст в 2 раза, чтобы на 240х240 он не был слишком мелким)
    int scale = 2;

    // Вычисляем общую ширину и высоту текста на экране с учетом масштаба
    int totalTextWidth = textLength * charWidth * scale;
    int totalTextHeight = charHeight * scale;

    // Расчет начальных координат для идеального центра
    int startX = (SCREEN_WIDTH - totalTextWidth) / 2;   // (240 - 208) / 2 = 16
    int startY = (SCREEN_HEIGHT - totalTextHeight) / 2; // (240 - 32) / 2 = 104

    ST7789_Fill(COLOR_BLACK);

    // 2. Посимвольный вывод надписи с масштабированием
    for (int i = 0; i < textLength; i++) {
        char ch = text[i];
        int charStartX = startX + (i * charWidth * scale);

        // Отрисовка символа построчно
        for (int row = 0; row < charHeight; row++) {
            uint8_t b = font8x16[(unsigned char)ch][row];
            for (int col = 0; col < charWidth; col++) {
                uint16_t pixelColor = (b & (0x80 >> col)) ? COLOR_WHITE : COLOR_BLACK;

                if (pixelColor == COLOR_BLACK) {
                	continue;
                }

                // Рисуем увеличенный пиксель (блок пикселей scale x scale)
                for (int sy = 0; sy < scale; sy++) {
                    for (int sx = 0; sx < scale; sx++) {
                    	ST7789_Rect(charStartX + (col * scale) + sx, startY + (row * scale) + sy, 1, 1, pixelColor);
                    }
                }
            }
        }
    }
}

