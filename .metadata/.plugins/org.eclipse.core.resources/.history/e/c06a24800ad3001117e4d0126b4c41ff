// 1. Низкоуровневые функции отправки
void ST7789_WriteCommand(uint8_t cmd) {
    HAL_GPIO_WritePin(GPIOA, GPIO_PIN_4, GPIO_PIN_RESET); // DC = 0 (Команда)
    HAL_SPI_Transmit(&hspi1, &cmd, 1, HAL_MAX_DELAY);
}

void ST7789_WriteData(uint8_t data) {
    HAL_GPIO_WritePin(GPIOA, GPIO_PIN_4, GPIO_PIN_SET);   // DC = 1 (Данные)
    HAL_SPI_Transmit(&hspi1, &data, 1, HAL_MAX_DELAY);
}

void ST7789_WriteDataBuf(uint8_t *buff, uint16_t buff_size) {
    HAL_GPIO_WritePin(GPIOA, GPIO_PIN_4, GPIO_PIN_SET);   // DC = 1 (Данные)
    HAL_SPI_Transmit(&hspi1, buff, buff_size, HAL_MAX_DELAY);
}

// 2. Инициализация дисплея (Hard Reset + базовые регистры)
void ST7789_Init(void) {
    // Аппаратный сброс (Reset)
    HAL_GPIO_WritePin(GPIOA, GPIO_PIN_6, GPIO_PIN_RESET);
    HAL_Delay(20);
    HAL_GPIO_WritePin(GPIOA, GPIO_PIN_6, GPIO_PIN_SET);
    HAL_Delay(120);

    ST7789_WriteCommand(0x11); // Sleep Out (Выход из спящего режима)
    HAL_Delay(120);

    ST7789_WriteCommand(0x3A); // Interface Pixel Format
    ST7789_WriteData(0x55);    // 16-bit color (RGB565)

    ST7789_WriteCommand(0x36); // Memory Data Access Control (Ориентация)
    ST7789_WriteData(0x00);    // Стандартная ориентация

    // Задаем границы экрана (от 0 до 239)
    ST7789_WriteCommand(0x2A); // Column Address Set
    ST7789_WriteData(0x00); ST7789_WriteData(0x00); // Start X = 0
    ST7789_WriteData(0x00); ST7789_WriteData(0xEF); // End X = 239

    ST7789_WriteCommand(0x2B); // Row Address Set
    ST7789_WriteData(0x00); ST7789_WriteData(0x00); // Start Y = 0
    ST7789_WriteData(0x00); ST7789_WriteData(0xEF); // End Y = 239

    ST7789_WriteCommand(0x21); // Display Inversion On (Обычно китайские IPS требуют инверсию)

    ST7789_WriteCommand(0x29); // Display On (Включение экрана)
    HAL_Delay(20);
}

// 3. Функция заливки экрана одним цветом
void ST7789_Fill(uint16_t color) {
    // Переворачиваем байты цвета, так как SPI отправляет MSB (старший байт) первым
    uint8_t data[2] = { (color >> 8) & 0xFF, color & 0xFF };

    // Устанавливаем окно на весь экран (240x240)
    ST7789_WriteCommand(0x2A);
    ST7789_WriteData(0x00); ST7789_WriteData(0x00);
    ST7789_WriteData(0x00); ST7789_WriteData(0xEF);

    ST7789_WriteCommand(0x2B);
    ST7789_WriteData(0x00); ST7789_WriteData(0x00);
    ST7789_WriteData(0x00); ST7789_WriteData(0xEF);

    // Команда начала записи в память RAM дисплея
    ST7789_WriteCommand(0x2C);

    // Заливаем пиксели (240 * 240 = 57600 пикселей)
    for (uint32_t i = 0; i < 57600; i++) {
        ST7789_WriteDataBuf(data, 2);
    }
}

// Цвета (в формате RGB565, который чаще всего используется для таких экранов)
#define COLOR_BLACK   0x2124 // Фон
#define COLOR_WHITE   0xEF7D // Текст

// Битовая матрица стандартного шрифта 8x16 (ASCII символы от ' ' до '~')
// Каждый байт — это одна строка символа шириной 8 пикселей. 1 - белый, 0 - черный.
const uint8_t font8x16[][16] = {
    // Здесь обычно находится весь массив ASCII. Ниже приведены только нужные нам символы для экономии места:
    ['H'] = {0x82, 0x82, 0x82, 0x82, 0x82, 0xFE, 0x82, 0x82, 0x82, 0x82, 0x82, 0x82, 0x82, 0x82, 0x82, 0x00},
    ['e'] = {0x00, 0x00, 0x00, 0x00, 0x00, 0x7C, 0x82, 0xFE, 0x80, 0x80, 0x82, 0x7C, 0x00, 0x00, 0x00, 0x00},
    ['l'] = {0x30, 0x10, 0x10, 0x10, 0x10, 0x10, 0x10, 0x10, 0x10, 0x10, 0x10, 0x18, 0x00, 0x00, 0x00, 0x00},
    ['o'] = {0x00, 0x00, 0x00, 0x00, 0x00, 0x7C, 0x82, 0x82, 0x82, 0x82, 0x82, 0x7C, 0x00, 0x00, 0x00, 0x00},
    [','] = {0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x30, 0x30, 0x10, 0x20, 0x00, 0x00},
    [' '] = {0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00},
    ['w'] = {0x00, 0x00, 0x00, 0x00, 0x00, 0x82, 0x82, 0x82, 0x92, 0x92, 0x92, 0x6C, 0x00, 0x00, 0x00, 0x00},
    ['r'] = {0x00, 0x00, 0x00, 0x00, 0x00, 0x9E, 0x62, 0x40, 0x40, 0x40, 0x40, 0xE0, 0x00, 0x00, 0x00, 0x00},
    ['d'] = {0x02, 0x02, 0x02, 0x7E, 0x82, 0x82, 0x82, 0x82, 0x82, 0x82, 0x86, 0x7A, 0x00, 0x00, 0x00, 0x00},
    ['!'] = {0x10, 0x10, 0x10, 0x10, 0x10, 0x10, 0x10, 0x10, 0x00, 0x00, 0x10, 0x10, 0x00, 0x00, 0x00, 0x00}
};

// Функция отрисовки одного пикселя (замените внутренности на функцию вашей библиотеки дисплея, например tft.drawPixel)
void drawPixel(int x, int y, uint16_t color) {
  ST7789_WriteCommand(0x2A);
  ST7789_WriteData(0x00); ST7789_WriteData(x);
  ST7789_WriteData(0x00); ST7789_WriteData(y);

  ST7789_WriteCommand(0x2B);
  ST7789_WriteData(0x00); ST7789_WriteData(x+1);
  ST7789_WriteData(0x00); ST7789_WriteData(y+1);

  // Команда начала записи в память RAM дисплея
  ST7789_WriteCommand(0x2C);

  ST7789_WriteData(color);
}

// Главная функция отрисовки сцены
void drawScene() {
    const char* text = "Hello, world!";
    int textLength = 13; // Количество символов в строке

    // Размеры одного символа в пикселях
    int charWidth = 8;
    int charHeight = 16;

    // Коэффициент масштабирования (увеличим текст в 2 раза, чтобы на 240х240 он не был слишком мелким)
    int scale = 2;

    // Вычисляем общую ширину и высоту текста на экране с учетом масштаба
    int totalTextWidth = textLength * charWidth * scale;
    int totalTextHeight = charHeight * scale;

    // Расчет начальных координат для идеального центра
    int startX = (240 - totalTextWidth) / 2;   // (240 - 208) / 2 = 16
    int startY = (240 - totalTextHeight) / 2; // (240 - 32) / 2 = 104

    ST7789_Fill(COLOR_BLACK);

    // 2. Посимвольный вывод надписи с масштабированием
    for (int i = 0; i < textLength; i++) {
        char ch = text[i];
        int charStartX = startX + (i * charWidth * scale);

        // Отрисовка символа построчно
        for (int row = 0; row < charHeight; row++) {
            uint8_t b = font8x16[(unsigned char)ch][row];
            for (int col = 0; col < charWidth; col++) {
                uint16_t pixelColor = (b & (0x80 >> col)) ? COLOR_WHITE : COLOR_BLACK;

                // Рисуем увеличенный пиксель (блок пикселей scale x scale)
                for (int sy = 0; sy < scale; sy++) {
                    for (int sx = 0; sx < scale; sx++) {
                        drawPixel(charStartX + (col * scale) + sx, startY + (row * scale) + sy, pixelColor);
                    }
                }
            }
        }
    }
}

